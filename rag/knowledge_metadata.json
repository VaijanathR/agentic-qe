    "version": "1.0",
    "status": "Approved Knowledge Metadata Baseline",
    "purpose": "Metadata registry for Agentic QE knowledge retrieval and progressive RAG",
    "governance": "Metadata controls retrieval relevance and authority but does not replace document content or governance rules"
  },
  "retrieval_principles": [
    {
      "principle_id": "RAG-PRINCIPLE-001",
      "principle": "Retrieve the latest approved authoritative baseline first"
    },
    {
      "principle_id": "RAG-PRINCIPLE-002",
      "principle": "Retrieve dependent technical and testing artifacts when the baseline is insufficient"
    },
    {
      "principle_id": "RAG-PRINCIPLE-003",
      "principle": "Retrieve historical defects and execution history when RCA, regression or impact analysis requires historical evidence"
    },
    {
      "principle_id": "RAG-PRINCIPLE-004",
      "principle": "Conflicting approved sources must be preserved and escalated for human governance rather than silently resolved"
    },
    {
      "principle_id": "RAG-PRINCIPLE-005",
      "principle": "Retrieval must record why a document was retrieved and how it influenced the task"
    },
    {
      "principle_id": "RAG-PRINCIPLE-006",
      "principle": "Historical evidence must not override the current approved requirement baseline"
    }
  ],
