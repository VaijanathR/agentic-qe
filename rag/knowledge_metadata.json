  "retrieval_strategy": {
    "step_1": "Retrieve latest approved requirement baseline",
    "step_2": "Retrieve relevant technical/API contract documents",
    "step_3": "Retrieve RTM and approved testcase baseline",
    "step_4": "Retrieve relevant test data",
    "step_5": "Retrieve historical defects when failure analysis or regression assessment requires it",
    "step_6": "Retrieve execution history when previous behavior or regression evidence is relevant",
    "step_7": "Detect conflicts across retrieved approved sources",
    "step_8": "Preserve conflicting evidence and trigger human governance where required",
    "step_9": "Record retrieval reason, source, version and relevance",
    "step_10": "Return fit-for-purpose knowledge to the requesting agent"
  },
  "authority_hierarchy": [
    {
      "level": 1,
      "authority": "Current approved requirement baseline",
      "examples": [
        "SRS_v1.md"
      ]
    },
    {
      "level": 2,
      "authority": "Current approved technical and API contract baseline",
      "examples": [
        "Customer_API_Technical_Spec.md",
        "customer_api.yaml"
      ]
    },
    {
      "level": 3,
      "authority": "Current approved QE testing baseline",
      "examples": [
        "RTM.csv",
        "testcases.json",
        "testdata.json"
      ]
    },
    {
      "level": 4,
      "authority": "Historical evidence",
      "examples": [
        "defect_history.json",
        "execution_history.json"
      ]
    },
    {
      "level": 5,
      "authority": "Agent inference",
      "examples": [
        "LLM-generated interpretation",
        "LLM-generated recommendation"
      ]
    }
  ],
  "governance": [
    {
      "rule_id": "RAG-GOV-001",
      "rule": "RAG retrieval provides evidence and context; it does not independently approve requirement changes"
    },
    {
      "rule_id": "RAG-GOV-002",
      "rule": "The LLM may reason over retrieved evidence but must not silently override an approved baseline"
    },
    {
      "rule_id": "RAG-GOV-003",
      "rule": "Rules Engine determines whether retrieved information crosses a governance boundary"
    },
    {
      "rule_id": "RAG-GOV-004",
      "rule": "Human approval is required when conflicting approved sources cannot be resolved by an existing approved governance rule"
    },
    {
      "rule_id": "RAG-GOV-005",
      "rule": "Historical documents remain retrievable even after defects are resolved or requirements change"
    },
    {
      "rule_id": "RAG-GOV-006",
      "rule": "No knowledge artifact may be deleted as part of normal Agentic QE operation"
    }
  ],
